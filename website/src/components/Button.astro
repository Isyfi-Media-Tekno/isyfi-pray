---
interface Props {
  href?: string;
  external?: boolean;
  variant?: "primary" | "secondary" | "disabled";
  size?: "md" | "sm";
  type?: "button" | "submit";
  class?: string;
}

const {
  href,
  external = false,
  variant = "primary",
  size = "md",
  type = "button",
  class: className = "",
} = Astro.props;

const base =
  "inline-flex items-center justify-center gap-2 rounded-full font-semibold transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand";

const sizes: Record<string, string> = {
  md: "px-7 py-3.5 text-base",
  sm: "px-4 py-2 text-sm",
};

const variants: Record<string, string> = {
  primary: "bg-brand text-white hover:bg-brand-dark",
  secondary: "border border-line bg-surface text-ink hover:border-brand hover:text-brand",
  disabled: "cursor-not-allowed border border-line bg-slate-100 text-muted/70 opacity-80 select-none",
};

const classes = [base, sizes[size], variants[variant], className].join(" ");

const linkProps = external ? { target: "_blank", rel: "noopener" } : {};
---

{
  href ? (
    <a href={href} class={classes} {...linkProps}>
      <slot />
    </a>
  ) : (
    <button type={type} disabled={variant === "disabled"} aria-disabled={variant === "disabled" ? "true" : undefined} class={classes}>
      <slot />
    </button>
  )
}
