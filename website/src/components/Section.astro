---
interface Props {
  id?: string;
  title?: string;
  subtitle?: string;
  class?: string;
}

const { id, title, subtitle, class: className = "" } = Astro.props;
---

<section id={id} class={["scroll-mt-20 py-16 md:py-24", className].join(" ")}>
  <div class="mx-auto w-full max-w-[1120px] px-6">
    {
      title && (
        <div class="mb-10 text-center md:mb-14">
          <h2 class="text-2xl font-extrabold tracking-tight text-ink md:text-4xl">{title}</h2>
          {subtitle && <p class="mx-auto mt-3 max-w-2xl text-muted">{subtitle}</p>}
        </div>
      )
    }
    <slot />
  </div>
</section>
