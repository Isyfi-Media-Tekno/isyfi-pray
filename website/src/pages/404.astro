---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import { withBase } from "../data/navigation";
import { siteConfig } from "../data/site";
---

<BaseLayout
  title="Halaman Tidak Ditemukan | Isyfi Pray"
  description="Halaman yang Anda cari tidak tersedia atau sudah dipindahkan."
  path="/404"
>
  <div class="mx-auto flex max-w-[1120px] flex-col items-center px-6 py-24 text-center">
    <p class="text-6xl font-extrabold tracking-tight text-brand md:text-8xl">404</p>
    <h1 class="mt-6 text-2xl font-extrabold tracking-tight text-ink md:text-4xl">Halaman tidak ditemukan</h1>
    <p class="mt-3 max-w-md text-muted">Halaman yang Anda cari tidak tersedia atau sudah dipindahkan.</p>

    <div class="mt-8 flex flex-col items-center gap-4 sm:flex-row">
      <Button href={siteConfig.apkUrl} external variant="primary" size="md">
        Download APK (Gratis)
      </Button>
      <a href={withBase("/")} class="text-sm font-semibold text-brand hover:underline">
        Kembali ke Beranda
      </a>
    </div>
  </div>
</BaseLayout>
