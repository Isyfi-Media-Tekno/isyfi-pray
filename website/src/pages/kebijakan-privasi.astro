---
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteConfig } from "../data/site";

const sections = [
  {
    heading: "Data yang Tidak Kami Kumpulkan",
    body: "Isyfi Pray tidak membuat akun, tidak mengumpulkan data pribadi, dan tidak mengirim lokasi masjid ke server mana pun.",
  },
  {
    heading: "Data yang Tersimpan di Perangkat",
    body: "Pengaturan jadwal sholat dan gambar yang diunggah tersimpan di penyimpanan lokal perangkat masjid dan tidak keluar dari perangkat.",
  },
  {
    heading: "Penggunaan Jaringan",
    body: "Siaran Live Makkah memuat YouTube sehingga tunduk pada kebijakan privasi Google. Sinkronisasi follower hanya berkomunikasi dengan TV master di jaringan lokal yang sama.",
  },
  {
    heading: "Cookie",
    body: "Situs ini tidak menggunakan cookie dan tidak melacak pengunjung.",
  },
];
---

<BaseLayout
  title="Kebijakan Privasi | Isyfi Pray"
  description="Bagaimana Isyfi Pray menjaga data Anda: tanpa akun, tanpa pelacakan, dan konfigurasi tersimpan di perangkat masjid."
  path="/kebijakan-privasi"
>
  <div class="mx-auto max-w-[1120px] px-6 pb-20 pt-16">
    <div class="mx-auto max-w-3xl">
      <h1 class="text-3xl font-extrabold tracking-tight text-ink md:text-4xl">Kebijakan Privasi</h1>
      <p class="mt-4 text-muted">
        Bagaimana Isyfi Pray menjaga data Anda: tanpa akun, tanpa pelacakan, dan konfigurasi tersimpan di
        perangkat masjid.
      </p>

      <div class="mt-10 space-y-8">
        {
          sections.map((section) => (
            <section>
              <h2 class="text-xl font-bold text-ink">{section.heading}</h2>
              <p class="mt-2 leading-relaxed text-muted">{section.body}</p>
            </section>
          ))
        }

        {
          siteConfig.email && (
            <section>
              <h2 class="text-xl font-bold text-ink">Kontak</h2>
              <p class="mt-2 leading-relaxed text-muted">
                Pertanyaan seputar privasi dapat dikirim ke{" "}
                <a href={`mailto:${siteConfig.email}`} class="font-medium text-brand hover:underline">
                  {siteConfig.email}
                </a>
                .
              </p>
            </section>
          )
        }
      </div>
    </div>
  </div>
</BaseLayout>
