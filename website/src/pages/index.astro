---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { Icon } from "astro-icon/components";
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/Section.astro";
import Button from "../components/Button.astro";
import DownloadButtons from "../components/DownloadButtons.astro";
import { appIcon } from "../data/assets";
import { siteConfig } from "../data/site";

const features = (await getCollection("features")).sort((a, b) => a.data.sortOrder - b.data.sortOrder);
const faqs = (await getCollection("faqs")).sort((a, b) => a.data.sortOrder - b.data.sortOrder);
const screenshots = (await getCollection("screenshots")).sort((a, b) => a.data.sortOrder - b.data.sortOrder);

const shots = import.meta.glob<ImageMetadata>("../assets/screenshots/*.jpg", {
  eager: true,
  import: "default",
});
const shotSrc = (image: string) => shots[`../assets/screenshots/${image}`];
const hero = screenshots.find((entry) => entry.data.id === "home")!;

const featureIcons: Record<string, string> = {
  "jadwal-sholat-akurat": "lucide:clock",
  "kalender-hijriah": "lucide:calendar-days",
  "adzan-iqomah-shalat": "lucide:bell-ring",
  "jumat-isyraq": "lucide:sunrise",
  "running-text": "lucide:type",
  "laporan-kas": "lucide:wallet",
  "live-makkah": "lucide:radio",
  "multi-tv": "lucide:tv",
  "atur-dari-browser": "lucide:qr-code",
};

const asset = (src: string) => `${import.meta.env.BASE_URL}${src.replace(/^\//, "")}`;
const abs = (src: string) => (siteConfig.siteUrl ? new URL(asset(src), siteConfig.siteUrl).href : asset(src));

const problems = [
  "Jadwal ditempel dan diubah setiap hari",
  "Lupa mematikan HP saat sholat",
  "Laporan kas tidak transparan",
];

const solutions = [
  "Jadwal dihitung otomatis di perangkat",
  "Transisi layar penuh berjalan sendiri",
  "Laporan kas digital di layar TV",
];

const steps = [
  {
    title: "Unduh & pasang",
    text: "Unduh APK di halaman ini dan pasang di Android TV, Android Box, atau tablet.",
  },
  {
    title: "Sambungkan Wi-Fi",
    text: "Hubungkan perangkat ke Wi-Fi yang sama dengan HP atau laptop Anda.",
  },
  {
    title: "Pindai QR & atur",
    text: "Buka QR di layar TV, pindai dari HP, lalu atur nama masjid, lokasi, dan tampilan langsung dari browser tanpa aplikasi tambahan.",
  },
];

const jsonLd: Record<string, unknown>[] = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: siteConfig.appName,
    description: siteConfig.description,
    applicationCategory: "LifestyleApplication",
    operatingSystem: "Android",
    downloadUrl: siteConfig.apkUrl,
    offers: { "@type": "Offer", price: "0", priceCurrency: "IDR" },
    screenshot: screenshots.map((entry) => abs(shotSrc(entry.data.image).src)),
    publisher: { "@type": "Organization", name: siteConfig.organizationName },
    ...(siteConfig.playStoreUrl ? { installUrl: siteConfig.playStoreUrl } : {}),
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: siteConfig.appName,
    ...(siteConfig.siteUrl ? { url: siteConfig.siteUrl } : {}),
  },
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: siteConfig.organizationName,
    ...(siteConfig.siteUrl ? { url: siteConfig.siteUrl } : {}),
    logo: abs(appIcon),
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((entry) => ({
      "@type": "Question",
      name: entry.data.question,
      acceptedAnswer: { "@type": "Answer", text: entry.data.answer },
    })),
  },
];
---

<BaseLayout
  title="Display Jadwal Sholat Digital untuk TV Masjid | Isyfi Pray"
  description={siteConfig.description}
  path="/"
  jsonLd={jsonLd}
>
  <!-- Hero -->
  <div class="mx-auto flex max-w-[1120px] flex-col items-center px-6 pb-12 pt-16 text-center">
    <p class="mb-6 inline-flex items-center gap-2 rounded-full border border-brand/40 bg-brand/5 px-4 py-1.5 text-xs font-semibold tracking-wide text-brand md:text-sm">
      <span class="h-1.5 w-1.5 rounded-full bg-brand" aria-hidden="true"></span>
      Gratis untuk masjid
    </p>

    <h1 class="mb-6 max-w-[920px] text-4xl font-extrabold leading-[1.15] tracking-tight text-ink sm:text-5xl lg:text-[54px]">
      Display Jadwal Sholat Digital untuk TV Masjid
    </h1>

    <p class="mb-10 max-w-[840px] text-base leading-relaxed text-muted sm:text-lg">
      Isyfi Pray menghitung jadwal sholat secara akurat di perangkat dengan metode Kemenag atau
      Muhammadiyah, lalu menjalankan tampilan Adzan, Iqomah, dan Shalat secara otomatis. Sekali pasang,
      berjalan 24/7 tanpa dioperasikan.
    </p>

    <DownloadButtons size="md" />
  </div>

  <div class="mx-auto mb-20 max-w-[1120px] px-6">
    <div class="overflow-hidden rounded-2xl border border-line bg-[#0a0e14] md:rounded-3xl">
      <Image
        src={shotSrc(hero.data.image)}
        alt={hero.data.alt}
        format="webp"
        widths={[480, 768, 1200]}
        sizes="(min-width: 1120px) 1120px, 100vw"
        loading="eager"
        fetchpriority="high"
        class="h-auto w-full"
      />
    </div>
  </div>

  <!-- Masalah → Solusi -->
  <Section id="masalah">
    <h2 class="text-center text-2xl font-extrabold tracking-tight text-ink md:text-4xl">Masalah Jadwal Sholat Manual dan Solusinya</h2>

    <div class="mt-10 grid items-stretch gap-6 md:grid-cols-2">
      <div class="rounded-2xl border border-line bg-surface p-6 md:p-8">
        <h3 class="text-lg font-bold text-ink">Masalah</h3>
        <ul class="mt-5 space-y-4">
          {
            problems.map((item) => (
              <li class="flex items-start gap-3 text-muted">
                <span class="mt-1.5 h-2.5 w-2.5 shrink-0 rounded-full bg-danger" aria-hidden="true" />
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="rounded-2xl border border-success/30 bg-surface p-6 md:p-8">
        <h3 class="text-lg font-bold text-ink">Solusi</h3>
        <ul class="mt-5 space-y-4">
          {
            solutions.map((item) => (
              <li class="flex items-start gap-3 text-muted">
                <Icon name="lucide:check" class="mt-1 h-5 w-5 shrink-0 text-success" aria-hidden="true" />
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    {
      siteConfig.masjidReference && (
        <p class="mt-8 text-center text-sm italic text-muted">{siteConfig.masjidReference}</p>
      )
    }
  </Section>

  <!-- Fitur Unggulan -->
  <Section id="fitur" title="Fitur Unggulan" subtitle="Semua kebutuhan display jadwal sholat masjid digital dalam satu aplikasi Android TV yang andal, akurat, dan mudah dikelola.">
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        features.map((feature) => (
          <article class="rounded-2xl border border-line bg-surface p-6 transition-colors hover:border-brand/40">
            <span class="mb-4 inline-flex h-10 w-10 items-center justify-center rounded-xl bg-brand-soft text-brand">
              <Icon name={featureIcons[feature.data.id] ?? "lucide:sparkles"} class="h-5 w-5" aria-hidden="true" />
            </span>
            <h3 class="text-base font-bold text-ink">{feature.data.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">{feature.data.description}</p>
          </article>
        ))
      }
    </div>
  </Section>

  <!-- Tangkapan Layar -->
  <Section id="tangkapan-layar" title="Tampilan Jam Sholat di TV Masjid" subtitle="Tangkapan layar asli aplikasi, dari jadwal harian sampai laporan kas masjid, dengan kontras yang nyaman dibaca dari jauh.">
    <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
      {
        screenshots.map((entry) => (
          <figure class="group flex flex-col">
            <a
              href={asset(shotSrc(entry.data.image).src)}
              data-lightbox
              data-caption={entry.data.caption}
              class="block cursor-zoom-in overflow-hidden rounded-2xl border border-line bg-[#0a0e14] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
            >
              <Image
                src={shotSrc(entry.data.image)}
                alt={entry.data.alt}
                format="webp"
                widths={[480, 768, 1200]}
                sizes="(min-width: 1024px) 350px, (min-width: 768px) 45vw, 92vw"
                loading="lazy"
                class="h-auto w-full transition-transform duration-300 group-hover:scale-[1.02]"
              />
            </a>
            <figcaption class="mt-3 text-center text-sm font-semibold text-ink">{entry.data.caption}</figcaption>
          </figure>
        ))
      }
    </div>
  </Section>

  <!-- Cara Pasang -->
  <Section id="cara-pasang" title="Cara Pasang di Android TV" subtitle="Tiga langkah singkat, dari unduh APK sampai TV masjid menampilkan jadwal sholat.">
    <ol class="grid gap-6 md:grid-cols-3">
      {
        steps.map((step, index) => (
          <li class="rounded-2xl border border-line bg-surface p-6">
            <span class="text-3xl font-extrabold text-brand">{String(index + 1).padStart(2, "0")}</span>
            <h3 class="mt-3 text-base font-bold text-ink">{step.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">{step.text}</p>
          </li>
        ))
      }
    </ol>
  </Section>

  <!-- Multi-TV & Offline -->
  <Section id="multi-tv">
    <div class="grid gap-6 md:grid-cols-2">
      <div class="rounded-2xl border border-line bg-surface p-6 md:p-8">
        <span class="mb-4 inline-flex h-10 w-10 items-center justify-center rounded-xl bg-brand-soft text-brand">
          <Icon name="lucide:tv" class="h-5 w-5" aria-hidden="true" />
        </span>
        <h2 class="text-lg font-bold text-ink">Multi-TV master-follower</h2>
        <p class="mt-2 text-muted">
          Satu TV master, TV lain follower. Perubahan dari browser master otomatis tersinkron setiap 30 detik.
        </p>
      </div>

      <div class="rounded-2xl border border-line bg-surface p-6 md:p-8">
        <span class="mb-4 inline-flex h-10 w-10 items-center justify-center rounded-xl bg-brand-soft text-brand">
          <Icon name="lucide:wifi-off" class="h-5 w-5" aria-hidden="true" />
        </span>
        <h2 class="text-lg font-bold text-ink">Berjalan offline</h2>
        <p class="mt-2 text-muted">
          Jadwal sholat dihitung di perangkat. Tanpa internet pun tetap berjalan; hanya siaran Live Makkah
          dan sinkronisasi antar-TV yang butuh jaringan.
        </p>
      </div>
    </div>
  </Section>

  <!-- FAQ -->
  <Section id="faq" title="Pertanyaan yang Sering Diajukan" subtitle="Jawaban singkat untuk pertanyaan yang paling sering ditanyakan pengurus masjid.">
    <div class="mx-auto max-w-3xl space-y-3">
      {
        faqs.map((entry) => (
          <details class="faq-item rounded-2xl border border-line bg-surface px-5">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-4 font-semibold text-ink">
              <span>{entry.data.question}</span>
              <Icon name="lucide:plus" class="faq-plus h-5 w-5 shrink-0 text-brand" aria-hidden="true" />
            </summary>
            <p class="pb-4 text-sm leading-relaxed text-muted">{entry.data.answer}</p>
          </details>
        ))
      }
    </div>
  </Section>

  <!-- Unduhan akhir -->
  <Section id="unduh" class="pb-24">
    <div class="mx-auto max-w-3xl rounded-3xl border border-line bg-surface px-6 py-12 text-center md:px-12">
      <h2 class="text-2xl font-extrabold tracking-tight text-ink md:text-4xl">Pasang Jam Sholat Digital di TV Masjid Anda</h2>
      <p class="mt-3 text-muted">Gratis untuk masjid, tanpa langganan dan tanpa akun.</p>

      <div class="mt-8">
        <DownloadButtons size="md" />
      </div>

      <p class="mt-6 text-xs text-muted sm:text-sm">Tombol Play Store akan aktif setelah aplikasi terbit.</p>

      {
        siteConfig.whatsappUrl && (
          <div class="mt-6">
            <Button href={siteConfig.whatsappUrl} external variant="secondary" size="md">
              <Icon name="lucide:message-circle" class="h-4 w-4" aria-hidden="true" />
              <span>Butuh bantuan pemasangan?</span>
            </Button>
          </div>
        )
      }
    </div>
  </Section>

  <!-- Lightbox overlay for the screenshot gallery -->
  <div id="lightbox" class="lightbox" hidden role="dialog" aria-modal="true" aria-label="Tampilan tangkapan layar">
    <button type="button" class="lightbox-backdrop" data-lightbox-close tabindex="-1" aria-label="Tutup tampilan"></button>
    <figure class="lightbox-figure">
      <img id="lightbox-image" src="" alt="" />
      <figcaption id="lightbox-caption"></figcaption>
    </figure>
    <button type="button" class="lightbox-close" data-lightbox-close aria-label="Tutup">
      <Icon name="lucide:x" class="h-5 w-5" aria-hidden="true" />
    </button>
  </div>

  <script>
    const lightbox = document.getElementById("lightbox");
    const lightboxImage = document.getElementById("lightbox-image") as HTMLImageElement | null;
    const lightboxCaption = document.getElementById("lightbox-caption");
    const lightboxClose = lightbox?.querySelector<HTMLButtonElement>(".lightbox-close");
    let lastTrigger: HTMLAnchorElement | null = null;

    function openLightbox(trigger: HTMLAnchorElement) {
      if (!lightbox || !lightboxImage) return;
      lastTrigger = trigger;
      lightboxImage.src = trigger.href;
      lightboxImage.alt = trigger.querySelector("img")?.alt ?? "";
      if (lightboxCaption) lightboxCaption.textContent = trigger.dataset.caption ?? "";
      lightbox.hidden = false;
      document.documentElement.style.overflow = "hidden";
      lightboxClose?.focus();
    }

    function closeLightbox() {
      if (!lightbox) return;
      lightbox.hidden = true;
      document.documentElement.style.overflow = "";
      lastTrigger?.focus();
    }

    document.querySelectorAll<HTMLAnchorElement>("a[data-lightbox]").forEach((link) => {
      link.addEventListener("click", (event) => {
        event.preventDefault();
        openLightbox(link);
      });
    });

    lightbox?.querySelectorAll("[data-lightbox-close]").forEach((element) => {
      element.addEventListener("click", closeLightbox);
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && lightbox && !lightbox.hidden) closeLightbox();
    });
  </script>
</BaseLayout>
